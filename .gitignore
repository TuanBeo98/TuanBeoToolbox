# ==============================================================================
# TuanBeoToolbox - .gitignore
# Bản quyền thuộc về: Mr. Tuấn Beo (TuanBeoToolbox)
# Chức năng: Chỉ loại bỏ các tệp nhật ký tạm và file rác hệ thống.
#            Toàn bộ công cụ Admin & Cấu hình đều được lưu lên Git của Anh Beo
#            để đồng bộ làm việc liền mạch trên mọi máy tính cá nhân.
# ==============================================================================

# Nhật ký thực thi cục bộ (File rác dọn dẹp)
Logs/*.log
!Logs/.gitkeep

# Thư mục tạm xuất gói cài đặt đóng gói sẵn cho khách hàng (tránh nặng repo)
Dist/

# Khóa bản quyền cục bộ của từng máy cá nhân (tránh đè key khi đổi máy)
Config/license.key
Config/.time-vault
Config/.license.dpapi
Config/.telemetry-queue

# File tạm hệ điều hành & Editor
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# VS Code / Visual Studio
.vscode/
.vs/
*.user
