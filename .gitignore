# ==============================================================================
# TuanBeoToolbox - .gitignore
# Bản quyền thuộc về: Mr. Tuấn Beo (TuanBeoToolbox)
# Chức năng: Loại bỏ nhật ký thực thi, file rác và gói nén đóng gói.
#            Bảo toàn 100% mã nguồn và tài liệu Admin trên Git riêng của Anh Beo.
# ==============================================================================

# Nhật ký thực thi cục bộ (phân cấp thư mục theo chức năng)
Engine/Logs/**
!Engine/Logs/.gitkeep
Logs/**
*.log

# Thư mục tạm xuất gói cài đặt đóng gói sẵn cho khách hàng (tránh nặng repo)
Engine/Dist/
Dist/

# Khóa bản quyền cục bộ của từng máy cá nhân (tránh đè key khi đổi máy)
Engine/Config/license.key
Engine/Config/.time-vault
Engine/Config/.license.dpapi
Engine/Config/.telemetry-queue
Config/license.key
Config/.time-vault
Config/.license.dpapi
Config/.telemetry-queue

# File tạm hệ điều hành & Editor
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# VS Code / Visual Studio
.vscode/
.vs/
*.user
