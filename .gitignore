# Nhật ký thực thi (Bảo vệ thông tin cá nhân)
Logs/*.log
!Logs/.gitkeep

# Tài liệu đặc tả nội bộ & Bí mật Admin (TUYỆT ĐỐI KHÔNG ĐẨY LÊN GITHUB PUBLIC)
Note.txt
*.secret
*.key
Config/key-ledger.json
Config/admin-whitelist.json
Config/pending-requests.json
Config/user-permissions.json
Config/.time-vault
Config/.license.dpapi
Config/.telemetry-queue
Config/admin-private.rsa
Config/.recovery.vault
Dist/
@File-BAT/@Administrator/
@File-BAT/ADMIN/
@File-BAT/*ADMIN*

# File tạm hệ thống & editor
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# VS Code / Visual Studio
.vscode/
.vs/
*.user
